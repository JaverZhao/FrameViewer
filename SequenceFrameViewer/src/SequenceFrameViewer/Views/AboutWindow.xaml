<Window x:Class="SequenceFrameViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 FrameView"
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FrameView" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
        <TextBlock Grid.Row="1" Text="版本 1.1.0" FontSize="14" Margin="0,4,0,0" />
        <TextBlock Grid.Row="2" Text="Windows 轻量化序列帧查看工具" FontSize="13" Margin="0,8,0,0" Foreground="#AAAAAA" />

        <Separator Grid.Row="3" Margin="0,12,0,8" Background="#3E3E3E" />

        <TextBlock Grid.Row="4" TextWrapping="Wrap" FontSize="12" Foreground="#888888"
                   VerticalAlignment="Top">
            快速预览 PNG / JPG / WebP / BMP 序列帧动画。
            支持播放控制、缩放、透明背景、循环播放等功能。
        </TextBlock>

        <Button Grid.Row="5" Content="确定" Width="80" Height="32" HorizontalAlignment="Right"
                Click="OnOkClick"
                Background="{StaticResource AccentBrush}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
