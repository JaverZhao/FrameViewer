<Window x:Class="SequenceFrameViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SequenceFrameViewer.ViewModels"
        xmlns:helpers="clr-namespace:SequenceFrameViewer.Helpers"
        xmlns:resx="clr-namespace:SequenceFrameViewer.Resources"
        mc:Ignorable="d"
        Title="FrameView" Height="940" Width="1400"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <helpers:BackgroundModeConverter x:Key="BackgroundModeConverter" />
        <helpers:BoolInvertConverter x:Key="BoolInvertConverter" />
                        <helpers:FolderNameConverter x:Key="FolderNameConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ToolbarIconPath" TargetType="Path">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{StaticResource IconBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Top Toolbar ============ -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel LastChildFill="False">
                <!-- Left section -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">

                    <!-- Open Folder -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenFolderCommand}" ToolTip="{Binding [OpenFolderTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeomFolderOpen}" Style="{StaticResource ToolbarIconPath}" />
                            <TextBlock Text="{Binding [Open], Source={x:Static resx:LocalizationService.Default}}" Margin="8,0,0,0" FontSize="21" />
                        </StackPanel>
                    </Button>

                    <!-- Recent Folders -->
                    <Grid Width="240" Margin="4,0">
                        <ComboBox ItemsSource="{Binding RecentFolders}"
                                  ToolTip="{Binding [RecentFoldersTooltip], Source={x:Static resx:LocalizationService.Default}}"
                                  SelectionChanged="OnRecentFolderSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource FolderNameConverter}}"
                                               TextTrimming="CharacterEllipsis" FontSize="19" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding [RecentFoldersPlaceholder], Source={x:Static resx:LocalizationService.Default}}"
                                   IsHitTestVisible="False"
                                   FontSize="19"
                                   Foreground="{StaticResource ForegroundSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Stretch"
                                   Margin="20,0,0,0"
                                   SnapsToDevicePixels="True" />
                    </Grid>

                    <!-- Reload -->
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ReloadCommand}" ToolTip="{Binding [ReloadTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <Path Data="{StaticResource GeomReload}" Style="{StaticResource ToolbarIconPath}" />
                    </Button>

                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Background Mode -->
                    <ComboBox ItemsSource="{Binding BackgroundModeOptions}"
                              SelectedValue="{Binding BackgroundMode}"
                              SelectedValuePath="Tag"
                              MinWidth="160"
                              ToolTip="{Binding [BackgroundModeTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeomLayer}" Width="28" Height="28" Stretch="Uniform"
                                          Fill="{StaticResource IconBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Display}" FontSize="19" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- FPS -->
                    <Label Content="{Binding [FpsLabel], Source={x:Static resx:LocalizationService.Default}}" VerticalAlignment="Center" FontSize="19" />
                     <TextBox x:Name="FpsTextBox"
                              Text="{Binding Fps, UpdateSourceTrigger=PropertyChanged}"
                              Width="96"
                              Height="48"
                              FontSize="19"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />

                    <!-- Loop Toggle -->
                    <ToggleButton Style="{StaticResource ToggleIconButtonStyle}"
                                  IsChecked="{Binding IsLooping}"
                                  ToolTip="{Binding [LoopTooltip], Source={x:Static resx:LocalizationService.Default}}"
                                  Margin="12,0,0,0">
                        <Path Data="{StaticResource GeomLoop}" Width="32" Height="32" Stretch="Uniform"
                              SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource IconBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLooping}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                </StackPanel>

                <!-- Right section -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <!-- Fit Window -->
                    <ToggleButton Style="{StaticResource ToggleIconButtonStyle}"
                                  IsChecked="{Binding IsFitToWindow, Mode=OneWay}"
                                  Command="{Binding FitWindowCommand}"
                                  ToolTip="{Binding [FitWindowTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <Path Data="{StaticResource GeomFit}" Width="32" Height="32" Stretch="Uniform"
                              SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource IconBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFitToWindow}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <!-- Original Size -->
                    <ToggleButton Style="{StaticResource ToggleIconButtonStyle}"
                                  IsChecked="{Binding IsFitToWindow, Converter={StaticResource BoolInvertConverter}, Mode=OneWay}"
                                  Command="{Binding ZoomOriginalCommand}"
                                  ToolTip="{Binding [OriginalSizeTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <Path Data="{StaticResource GeomOriginal}" Width="32" Height="32" Stretch="Uniform"
                              SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource IconBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFitToWindow, Converter={StaticResource BoolInvertConverter}}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WindowBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <!-- Zoom Level -->
                    <TextBlock Text="{Binding ZoomText}"
                               VerticalAlignment="Center"
                               FontSize="19"
                               Foreground="{StaticResource ForegroundSecondaryBrush}"
                               Margin="8,0,16,0" />

                    <!-- Language -->
                    <ComboBox x:Name="LanguageCombo"
                              SelectedIndex="0"
                              MinWidth="120"
                              Height="56"
                              FontSize="19"
                              VerticalAlignment="Center"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="中文" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>

                    <Separator Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- About -->
                    <Button Style="{StaticResource IconButtonStyle}" Command="{Binding ShowAboutCommand}" ToolTip="{Binding [AboutTooltip], Source={x:Static resx:LocalizationService.Default}}">
                        <Path Data="{StaticResource GeomInfo}" Style="{StaticResource ToolbarIconPath}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Preview Area ============ -->
        <Border Grid.Row="1"
                Background="{Binding BackgroundMode, Converter={StaticResource BackgroundModeConverter}}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0"
                ClipToBounds="True"
                x:Name="PreviewBorder">

            <Grid x:Name="PreviewContainer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ScaleTransform" />
                        <TranslateTransform x:Name="TranslateTransform" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="PreviewImage"
                       Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       UseLayoutRounding="True"
                       SnapsToDevicePixels="True">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!-- Empty State -->
                <TextBlock Text="{Binding EmptyStateMessage}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="26"
                           Foreground="{StaticResource ForegroundMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ============ Bottom Bar (Slider + Controls) ============ -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Timeline Slider -->
                <Border Grid.Row="0" Padding="16,0" Background="{StaticResource PanelBackgroundBrush}">
                    <Slider x:Name="FrameSlider"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding FrameSliderValue}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="10" />
                </Border>

                <!-- Controls Bar -->
                <Border Grid.Row="1" Padding="12,4,16,4" Background="{StaticResource ToolbarBackgroundBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Playback Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding GoToFirstFrameCommand}"
                                    ToolTip="{Binding [FirstFrameTooltip], Source={x:Static resx:LocalizationService.Default}}">
                                <Path Data="{StaticResource GeomFirstFrame}"
                                      Style="{StaticResource ToolbarIconPath}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding PreviousFrameCommand}"
                                    ToolTip="{Binding [PrevFrameTooltip], Source={x:Static resx:LocalizationService.Default}}">
                                <Path Data="{StaticResource GeomPrevFrame}"
                                      Style="{StaticResource ToolbarIconPath}" />
                            </Button>
                            <Button Style="{StaticResource PlayButtonStyle}"
                                    Command="{Binding PlayPauseCommand}"
                                    ToolTip="{Binding [PlayPauseTooltip], Source={x:Static resx:LocalizationService.Default}}">
                                <Grid>
                                    <Path Data="{StaticResource GeomPlay}" Stretch="Uniform" Width="52" Height="52"
                                          Fill="{StaticResource IconBrush}" SnapsToDevicePixels="True">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource GeomPause}" Stretch="Uniform" Width="40" Height="40"
                                          Fill="{StaticResource IconBrush}" SnapsToDevicePixels="True">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding NextFrameCommand}"
                                    ToolTip="{Binding [NextFrameTooltip], Source={x:Static resx:LocalizationService.Default}}">
                                <Path Data="{StaticResource GeomNextFrame}"
                                      Style="{StaticResource ToolbarIconPath}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding GoToLastFrameCommand}"
                                    ToolTip="{Binding [LastFrameTooltip], Source={x:Static resx:LocalizationService.Default}}">
                                <Path Data="{StaticResource GeomLastFrame}"
                                      Style="{StaticResource ToolbarIconPath}" />
                            </Button>
                        </StackPanel>

                        <!-- Frame Info -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="19" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                       Text="{Binding [FrameLabel], Source={x:Static resx:LocalizationService.Default}}" />
                            <TextBlock Text=":" FontSize="19"
                                       Foreground="{StaticResource ForegroundSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentFrameIndex}" FontSize="19" Margin="4,0,0,0" />
                            <TextBlock Text="/" FontSize="19" Margin="8,0" Foreground="{StaticResource ForegroundMutedBrush}" />
                            <TextBlock Text="{Binding TotalFrames}" FontSize="19" />
                            <TextBlock Text="|" FontSize="19" Margin="16,0" Foreground="{StaticResource ForegroundMutedBrush}" />
                            <TextBlock Text="{Binding FrameSizeText}" FontSize="19"
                                       Foreground="{StaticResource ForegroundSecondaryBrush}" />
                            <TextBlock Text="|" FontSize="19" Margin="16,0" Foreground="{StaticResource ForegroundMutedBrush}" />
                            <TextBlock Text="{Binding CurrentFileName}" FontSize="19"
                                       Foreground="{StaticResource ForegroundSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="360" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
